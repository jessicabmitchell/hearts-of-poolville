# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never put this in client code or share it. It can read every submission.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=you@example.com

# Any long random string (for example: openssl rand -hex 32). Lets Vercel's weekly
# keep-alive job call /api/keepalive. Set it in Vercel too.
CRON_SECRET=a-long-random-string
